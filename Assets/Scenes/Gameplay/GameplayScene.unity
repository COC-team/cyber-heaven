      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: 'Ah, a fresh face in this broken paradise. You see, kid, CyberHeaven
        wasn''t always like this. '
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: "It was flawless once, a place without pain, until the glitches began.
        Now, everything\u2019s twisted. "
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "They say pressing the Ctrl button can reset things\u2026 but I\u2019ve
        seen too many lose themselves to that command. Be careful with your choices."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[0].dialogueCharacter
      value: 
      objectReference: {fileID: 11400000, guid: f2735608d8e60624aa213ebb620ae513, type: 2}
