      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: "Hey there, newcomer! Welcome to CyberHeaven! They say this place is
        perfect, right? But you seem a little\u2026 tense. "
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: 'Try letting go, you know? Sometimes, all it takes is one simple action
        to loosen up. '
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: Why don't you press the Ctrl button and see what happens? It's all part
        of feeling truly out of control!
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[0].dialogueCharacter
      value: 
      objectReference: {fileID: 11400000, guid: 72ec458e1dbb8284297d75269028fb26, type: 2}
